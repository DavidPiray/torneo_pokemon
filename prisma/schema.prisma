generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model Perfil {
  id                  String   @id @db.Uuid
  discord_id          String?  @unique
  nombre_streamer     String
  minecraft_uuid      String   @unique
  pais                String?  @default("ND")
  es_npc              Boolean  @default(false)
  
  // Starter
  pokemon_inicial_id  Int?
  pokemon_inicial_nom String?

  // Redes Sociales en JSON ({ twitch: "...", youtube: "...", kick: "...", tiktok: "..." })
  redes_sociales      Json?

  created_at          DateTime @default(now())

  clasificacion       Clasificacion?
  equipo              EquipoPokemon[]
  notificaciones      Notificacion[]

  enfrentamientosComoJ1 Enfrentamiento[]  @relation("EnfrentamientosJ1")
  enfrentamientosComoJ2 Enfrentamiento[]  @relation("EnfrentamientosJ2")
  enfrentamientosGanados Enfrentamiento[] @relation("EnfrentamientosGanador")

  @@map("perfiles")
  @@schema("public")
}

model Clasificacion {
  id        String   @id @default(uuid()) @db.Uuid
  perfil_id String   @unique @db.Uuid
  elo       Int      @default(1000)
  rango     String   @default("Normal")
  victorias Int      @default(0)
  derrotas  Int      @default(0)

  perfil    Perfil   @relation(fields: [perfil_id], references: [id], onDelete: Cascade)

  @@map("clasificacion")
  @@schema("public")
}

model EquipoPokemon {
  id         String   @id @default(uuid()) @db.Uuid
  perfil_id  String   @db.Uuid
  slot       Int
  pokemon_id Int
  nombre     String
  sprite_url String

  perfil     Perfil   @relation(fields: [perfil_id], references: [id], onDelete: Cascade)

  @@unique([perfil_id, slot])
  @@map("equipos_pokemon")
  @@schema("public")
}

model Notificacion {
  id         String   @id @default(uuid()) @db.Uuid
  perfil_id  String   @db.Uuid
  titulo     String
  mensaje    String
  leido      Boolean  @default(false)
  created_at DateTime @default(now())

  perfil     Perfil   @relation(fields: [perfil_id], references: [id], onDelete: Cascade)

  @@map("notificaciones")
  @@schema("public")
}

model AnuncioGlobal {
  id         String   @id @default(uuid()) @db.Uuid
  titulo     String
  contenido  String
  tipo       String   @default("evento")
  created_at DateTime @default(now())

  @@map("anuncios_globales")
  @@schema("public")
}

model ConfiguracionTorneo {
  id              Int     @id @default(1)
  fase_actual     String  @default("REGISTRO") // REGISTRO, REVELADO, EN_JUEGO, FINALIZADO
  revelar_equipos Boolean @default(false)

  @@map("configuracion_torneo")
  @@schema("public")
}

model Enfrentamiento {
  id            String   @id @default(uuid()) @db.Uuid
  tipo          String   @default("FASE_REGULAR") // "FASE_REGULAR" | "PLAYOFFS"
  fase          String   // "JORNADA_1", "JORNADA_2", "CUARTOS_1", "SEMIFINAL_1", "FINAL"
  
  jugador1_id   String   @db.Uuid
  jugador2_id   String   @db.Uuid
  ganador_id    String?  @db.Uuid  // Nulo si aún no se ha jugado
  
  // Snapshots de los equipos de 6 Pokémon en el momento exacto del combate
  equipo_j1     Json?    
  equipo_j2     Json?    

  // Variación de ELO tras el combate (Opcional)
  elo_cambio_j1 Int?     @default(0) // Ej: +25 o -18
  elo_cambio_j2 Int?     @default(0)

  fecha_combate DateTime @default(now())

  // Relaciones con Perfil
  jugador1      Perfil   @relation("EnfrentamientosJ1", fields: [jugador1_id], references: [id])
  jugador2      Perfil   @relation("EnfrentamientosJ2", fields: [jugador2_id], references: [id])
  ganador       Perfil?  @relation("EnfrentamientosGanador", fields: [ganador_id], references: [id])

  @@map("enfrentamientos")
  @@schema("public")
}